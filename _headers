# HEARTH™ — Netlify headers

/resources/*.xlsx
  Content-Type: application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
  Content-Disposition: attachment

/resources/*.docx
  Content-Type: application/vnd.openxmlformats-officedocument.wordprocessingml.document
  Content-Disposition: attachment

/downloads/*.zip
  Content-Type: application/zip
  Content-Disposition: attachment

# CSS/JS are versioned (?v=...) in every page, but always re-check them so updates show immediately
/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/img/*
  Cache-Control: public, max-age=86400

/assets/video/*
  Cache-Control: public, max-age=86400

# Netlify functions — unrestricted so the browser can POST to them
/.netlify/functions/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Headers: Content-Type
  Access-Control-Allow-Methods: POST, OPTIONS

# Security headers for HTML pages
/*.html
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: form-action 'self' https://docs.google.com; connect-src 'self' https://docs.google.com https://cdn.jsdelivr.net https://ogxnqfensgdfjqaronsi.supabase.co wss://ogxnqfensgdfjqaronsi.supabase.co

/
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: form-action 'self' https://docs.google.com; connect-src 'self' https://docs.google.com https://cdn.jsdelivr.net https://ogxnqfensgdfjqaronsi.supabase.co wss://ogxnqfensgdfjqaronsi.supabase.co
